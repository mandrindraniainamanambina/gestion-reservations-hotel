# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne commitez JAMAIS ".env".
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=remplacez-moi-par-une-longue-cle-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=hotel_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=choisissez-un-mot-de-passe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Mot de passe des comptes de démonstration (commande seed_demo)
DEMO_PASSWORD=choisissez-un-mot-de-passe-demo
